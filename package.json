{
  "name": "relax-launcher",
  "productName": "Relax Launcher",
  "version": "0.1.7",
  "private": true,
  "description": "Relax Launcher — быстрый лаунчер Minecraft: Vanilla, Fabric, моды и сборки Modrinth, офлайн-аккаунты",
  "author": "Relax",
  "homepage": "https://github.com/veer47194-design/relax-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/veer47194-design/relax-launcher.git"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:linux": "npm run build && electron-builder --linux deb --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.relax.launcher",
    "productName": "Relax Launcher",
    "copyright": "Copyright © 2026 Relax",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relax Launcher",
      "artifactName": "Relax-Launcher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Relax-Launcher-Portable-${version}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2",
        "libatk-bridge2.0-0",
        "libcups2",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxrandr2",
        "libxshmfence1",
        "libpango-1.0-0",
        "libcairo2",
        "libdbus-1-3",
        "libglib2.0-0",
        "libxkbcommon0"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["deb"],
      "category": "Game",
      "maintainer": "Relax Launcher <veer47194-design@users.noreply.github.com>",
      "description": "Relax Launcher — лаунчер Minecraft с модами и сборками",
      "artifactName": "Relax-Launcher-linux-${version}.${ext}",
      "electronLanguages": ["en", "ru"]
    }
  }
}
